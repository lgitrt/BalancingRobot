<?xml version="1.0"?>
<!-- Author: Luca Obwegs -->
<sdf version="1.10">
  <model name="balancing_robot">
    <pose>0 0 ${initial_z} 0 ${initial_pitch} 0</pose>
    <static>false</static>
    <self_collide>false</self_collide>
    <link name="chassis">
      <pose>0 0 ${com_height} 0 0 0</pose>
      <inertial>
        <mass>${chassis_mass}</mass>
        <inertia>
          <ixx>${chassis_ixx}</ixx><iyy>${chassis_iyy}</iyy><izz>${chassis_izz}</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="chassis_visual">
        <geometry><box><size>${chassis_x} ${chassis_y} ${chassis_z}</size></box></geometry>
        <material><ambient>0.10 0.35 0.75 1</ambient><diffuse>0.10 0.35 0.75 1</diffuse></material>
      </visual>
      <collision name="chassis_collision">
        <geometry><box><size>${chassis_x} ${chassis_y} ${chassis_z}</size></box></geometry>
      </collision>
      <sensor name="imu_sensor" type="imu">
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>${imu_rate}</update_rate>
        <topic>/world/balancing_world/model/balancing_robot/link/chassis/sensor/imu_sensor/imu</topic>
        <imu><angular_velocity><x><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></x><y><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></y><z><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></z></angular_velocity><linear_acceleration><x><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></x><y><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></y><z><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></z></linear_acceleration></imu>
      </sensor>
    </link>
    <link name="left_wheel">
      <pose>0 ${wheel_half_separation} 0 0 0 0</pose>
      <inertial>
        <mass>${wheel_mass}</mass>
        <inertia>
          <ixx>${wheel_transverse_inertia}</ixx><iyy>${wheel_axial_inertia}</iyy><izz>${wheel_transverse_inertia}</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="wheel_visual"><pose>0 0 0 1.57079632679 0 0</pose><geometry><cylinder><radius>${wheel_radius}</radius><length>${wheel_width}</length></cylinder></geometry><material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material></visual>
      <collision name="wheel_collision"><pose>0 0 0 1.57079632679 0 0</pose><geometry><cylinder><radius>${wheel_radius}</radius><length>${wheel_width}</length></cylinder></geometry><surface><friction><ode><mu>${wheel_ground_friction}</mu><mu2>${wheel_ground_friction_lateral}</mu2></ode></friction></surface></collision>
    </link>
    <link name="right_wheel">
      <pose>0 ${wheel_minus_half_separation} 0 0 0 0</pose>
      <inertial>
        <mass>${wheel_mass}</mass>
        <inertia>
          <ixx>${wheel_transverse_inertia}</ixx><iyy>${wheel_axial_inertia}</iyy><izz>${wheel_transverse_inertia}</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="wheel_visual"><pose>0 0 0 1.57079632679 0 0</pose><geometry><cylinder><radius>${wheel_radius}</radius><length>${wheel_width}</length></cylinder></geometry><material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material></visual>
      <collision name="wheel_collision"><pose>0 0 0 1.57079632679 0 0</pose><geometry><cylinder><radius>${wheel_radius}</radius><length>${wheel_width}</length></cylinder></geometry><surface><friction><ode><mu>${wheel_ground_friction}</mu><mu2>${wheel_ground_friction_lateral}</mu2></ode></friction></surface></collision>
    </link>
    <joint name="left_wheel_joint" type="revolute">
      <parent>chassis</parent><child>left_wheel</child>
      <pose>0 ${wheel_half_separation} ${joint_z} 0 0 0</pose>
      <axis><xyz>0 1 0</xyz><limit><effort>20</effort><velocity>${max_wheel_rate}</velocity></limit><dynamics><damping>0.015</damping></dynamics></axis>
    </joint>
    <joint name="right_wheel_joint" type="revolute">
      <parent>chassis</parent><child>right_wheel</child>
      <pose>0 ${wheel_minus_half_separation} ${joint_z} 0 0 0</pose>
      <axis><xyz>0 1 0</xyz><limit><effort>20</effort><velocity>${max_wheel_rate}</velocity></limit><dynamics><damping>0.015</damping></dynamics></axis>
    </joint>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <topic>/model/balancing_robot/cmd_vel</topic>
      <odom_topic>/model/balancing_robot/odometry</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>chassis</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
      <max_linear_velocity>${max_speed}</max_linear_velocity>
      <max_angular_velocity>8</max_angular_velocity>
    </plugin>
  </model>
</sdf>
